# Copy this file to .env and replace all three placeholders.
# Generate each value with: openssl rand -hex 32
PORT=4000
BIND_HOST=0.0.0.0
DATABASE_URL=postgresql://ehumure:change_this_password@localhost:5432/ehumure
JWT_SECRET=replace_with_random_64_hex_characters
PHONE_KEY=replace_with_random_64_hex_characters
SETUP_SECRET=replace_with_random_64_hex_characters

# SMS provider: simulator (default) or africastalking.
# Never put a real key in this file: it is committed to GitHub. Put it only in backend/.env.
# Markers: see MARKER_GUIDE.md, section 2, for how to get and use the sandbox key.
SMS_PROVIDER=simulator
AT_USERNAME=
AT_API_KEY=
AT_ENDPOINT=https://api.sandbox.africastalking.com/version1/messaging
# Optional; only set this if the sender ID is configured for your account.
AT_SENDER_ID=
